{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "../types/page-scripts.d.ts"
  ]
}
